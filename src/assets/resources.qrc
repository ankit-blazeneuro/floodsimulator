        <file alias="map.svg">icons/map.svg</file>
        <file alias="radar.svg">icons/radar.svg</file>
        <file alias="graph.svg">icons/graph.svg</file>
        <file alias="rain.svg">icons/rain.svg</file>
        <file alias="cloud.svg">icons/cloud.svg</file>
        <file alias="cloud-snowfall.svg">icons/cloud-snowfall.svg</file>
        <file alias="fog.svg">icons/fog.svg</file>
